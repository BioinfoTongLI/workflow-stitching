process {
    // PREPROCESS_PHENIX_ICECHUNK: each round and well is stitched as a 3D stack by its own
    // MULTIVIEWSTITCHER task, then all wells of a sample go into one stitched HCS plate.
    // The per-well ome.zarr are not published, their pixels are copied into the plate.
    withName: 'PREPROCESS_PHENIX_ICECHUNK:PHENIXICECHUNK' {
        ext.args   = '--flatfield'
        publishDir = [
            "path": "${params.out_dir}/icechunk",
            "mode": 'copy',
            "pattern": "*.{icechunk,summary.json}",
        ]
    }
    withName: MULTIVIEWSTITCHER {
        ext.args   = { "--projection none --wells ${meta.well}" }
        publishDir = [
            "path": "${params.out_dir}/qc",
            "mode": 'copy',
            "pattern": "*.{png,csv}",
        ]
    }
    withName: ICECHUNK_STITCHEDPLATE {
        publishDir = [
            "path": params.out_dir,
            "mode": 'copy',
        ]
    }

    // PHENIX_ICECHUNK_ASHLAR: ashlar needs z projected fields, so the conversion flatfield
    // corrects, max projects and exports per-well OME-TIFFs, then ashlar stitches each well
    // and registers every round to the first one
    withName: 'PHENIX_ICECHUNK_ASHLAR:PHENIXICECHUNK' {
        ext.args   = '--flatfield --zproject max --ome-tiff .'
        publishDir = [
            "path": "${params.out_dir}/icechunk",
            "mode": 'copy',
            "pattern": "*.{icechunk,summary.json}",
        ]
    }
    withName: 'PHENIX_ICECHUNK_ASHLAR:ASHLAR' {
        ext.args   = "-c 0 -m 30 --filter-sigma 25.0"
        publishDir = [
            "path": params.out_dir,
            "mode": 'copy',
        ]
    }
}
