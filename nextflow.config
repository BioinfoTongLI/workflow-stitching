profiles {
    lsf {
        process.executor='lsf'
        executor {
            name = 'lsf'
            queueSize = 10
            // https://www.nextflow.io/docs/latest/executor.html#lsf
            perJobMemLimit = true
        }
        process.queue = 'imaging'
    }

    local{
        executor = 'local'
        docker.enabled = false
        docker.registry = "quay.io"
        singularity.enabled = true
    }
}

trace {
    enabled = true
    file = 'pipeline_trace.tsv'
    sep = '\t'
    fields = 'script,env,read_bytes,write_bytes,peak_vmem,peak_rss,vmem,%cpu,%mem,realtime,duration,queue,attempt,memory,disk,cpus,container,module,status,name,hash'
    overwrite = true
}


process {
    withName: ASHLAR {
	    ext.args = "-c 4 --flip-y -m 20 --filter-sigma '15.0'"
        publishDir = [
            path:"results/ashlar",
            mode : 'copy'
        ]
    }
}

manifest.name = 'workflows-ashlar-stitching'
manifest.version = '0.0.1'
manifest.description = "Run ASHLAR stitching workflow"
